<Window x:Class="Mixr.UI.Views.DeviceSwitchPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Theme="clr-namespace:Mixr.UI.Themes"
        xmlns:b="clr-namespace:Mixr.UI.Behaviors"
        Title="Mixr"
        Theme:Brush.Foreground="Text"
        Theme:Options.Source="System"
        b:FrameworkElementEx.FlowDirection="Auto"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStyle="None">
    <Border Padding="20,12"
            Theme:Brush.Background="Background"
            Theme:Brush.BorderBrush="Theme=Transparent, HighContrast=Text"
            BorderThickness="1"
            CornerRadius="8">
        <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="20"
                       Text="&#xE7F5;" />
            <TextBlock x:Name="DeviceNameText"
                       MaxWidth="400"
                       VerticalAlignment="Center"
                       FontSize="16"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Border>
</Window>
